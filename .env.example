# Shared secret required to create/edit/delete boards, pages, and sounds (and to
# upload audio) via the API. Reads + playback are open (it's your own board on a
# private Tailscale network). Generate one with:  openssl rand -hex 24
JARVIS_TOKEN=change-me-to-a-long-random-string

# Where the SQLite file lives (optional; defaults to ./data/soundboard.db)
# SOUNDBOARD_DB_PATH=/opt/soundboard/data/soundboard.db

# Where uploaded audio bytes live on disk (optional; defaults to ./data/sounds).
# Each environment gets its own directory, so dev + prod never share files.
# SOUNDBOARD_MEDIA_DIR=/opt/soundboard/data/sounds

# Set to "dev" on the DEV deployment to show the amber non-prod banner.
# Leave UNSET on prod. (Prod is also hard-guarded by its :4720 port.)
# JARVIS_ENV=dev
