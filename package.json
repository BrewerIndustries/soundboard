{
  "name": "soundboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev --env dev",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run build",
    "db:migrate:dev": "wrangler d1 migrations apply soundboard-dev --env dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply soundboard-prod --remote",
    "deploy:dev": "npm run build && wrangler deploy --env dev",
    "deploy:prod": "npm run build && wrangler deploy",
    "migrate:from-server": "node scripts/migrate-from-server.mjs"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
