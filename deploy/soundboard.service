[Unit]
Description=Soundboard (Next.js)
After=network.target

[Service]
Type=simple
User=dan
WorkingDirectory=/opt/soundboard
Environment=NODE_ENV=production
Environment=PORT=4720
# Real secrets (JARVIS_TOKEN) live in /opt/soundboard/.env:
EnvironmentFile=/opt/soundboard/.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
